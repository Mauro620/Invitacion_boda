# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invitacion
# 32+ char secret for iron-session cookie encryption
SESSION_SECRET=change-me-to-a-long-random-string-32chars
# Admin users: email:bcryptHash,email:bcryptHash
ADMIN_USERS=
# Public base URL used in invitation links
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development
